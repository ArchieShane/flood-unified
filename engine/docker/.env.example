# 复制成 docker/.env（install_server.sh 会自动生成）。scripts/*.sh 和 docker-compose.worker.yml 都读它。
TAG=v3
NAS_DIR=/media/pop-fs/flood_data      # NAS 在这台服务器上的挂载路径（三台可以不同，成果都落在同一个 NAS 目录）
WORK_DIR=/data/swbrain_work           # 工作目录：本机磁盘，路径里不能有中文，建议 ≥ 200 GB
THREADS=5                              # 每个算例的线程数
# MAKANI_PASSWORD=                     # 只有打新区域数据包时才要；日常推演不读 Makani，不要写进这个文件提交

# DTM_PATH=/path/to/dtm_50cm.tif        # 服务器上的高精度 DTM（EPSG:32640）：单个 tif，或放分块 tif 的目录。不设就用包里 5 m 的 dtm_5m.tif
