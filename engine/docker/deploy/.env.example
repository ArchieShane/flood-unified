# 复制成 .env 再改（start.sh 第一次运行会自动生成）。路径用绝对路径，WORK_DIR 必须纯英文、无空格（SWMM 不认中文路径）
VERSION=__VERSION__
PORT=8766
BIND=0.0.0.0
DATA_DIR=/opt/swbrain/data
WORK_DIR=/opt/swbrain/work
RUNTIME_DIR=/opt/swbrain/runtime
# 离线数据库口令：start.sh 生成随机值并写进 runtime/config.toml 的 [source.*]；只在 compose 内网用，不对外发布端口
DB_PASSWORD=__DB_PASSWORD__
# 纯离线：大模型密钥留空 = 规则规划器
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
